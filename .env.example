# Recall.ai — Profilr workspace, EU (Frankfurt). Keep every value server-side only.
RECALL_REGION=eu-central-1
# REST API key for the Profilr workspace (never commit, never expose to the browser).
RECALL_API_KEY=
# Workspace verification secret (whsec_...). get_info reports dashboard_secret_source=workspace_verification_secret.
RECALL_WEBHOOK_VERIFICATION_SECRET=
# Stable public HTTPS origin of this backend (no localhost / IPs). Webhooks: $PUBLIC_API_BASE_URL/webhooks/recall
PUBLIC_API_BASE_URL=
# Calendar V2: Recall regional callback returned by the setup action; /oauth/google/callback forwards to it.
RECALL_CALENDAR_REGIONAL_CALLBACK_URI=
# Bearer token required by the Profilr UI/API (not by Recall-facing routes, which use signature verification).
APP_ACCESS_TOKEN=
# Optional
PORT=3000
DATABASE_PATH=./data/profilr-meetings.sqlite
BOT_NAME=Profilr Notetaker
